<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="KlarnaPayment\Service\ScheduledTask\AuthorizeOrders\AuthorizeOrdersTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="KlarnaPayment\Service\ScheduledTask\AuthorizeOrders\AuthorizeOrdersHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>

            <argument type="service" id="order.repository"/>
            <argument type="service" id="KlarnaPayment\Components\Client\Client" />
            <argument type="service" id="KlarnaPayment\Components\Client\Hydrator\Request\GetOrder\GetOrderRequestHydrator" />
            <argument type="service" id="KlarnaPayment\Components\Helper\StateHelper\Authorize\AuthorizeStateHelper"/>
            <argument type="service" id="Shopware\Core\Checkout\Order\Aggregate\OrderTransaction\OrderTransactionStateHandler"/>
            <argument type="service" id="monolog.logger.KlarnaPayment"/>

            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
